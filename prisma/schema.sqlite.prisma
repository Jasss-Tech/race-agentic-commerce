datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  role              String             @default("BUYER")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  mandates          Mandate[]
  orders            Order[]
  agentInteractions AgentInteraction[]
}

model Merchant {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  description           String
  currency              String                 @default("INR")
  trustScore            Int                    @default(95)
  aiReadinessScore      Int                    @default(94)
  agentEnabled          Boolean                @default(true)
  passportData          String?                // JSON string of AI readiness breakdowns
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  products              Product[]
  orders                Order[]
  campaigns             Campaign[]
  growthRecommendations GrowthRecommendation[]
  policies              Policy[]
}

model Product {
  id                    String                 @id @default(cuid())
  merchantId            String
  name                  String
  slug                  String                 @unique
  description           String
  category              String
  price                 Float
  currency              String                 @default("INR")
  stock                 Int                    @default(50)
  active                Boolean                @default(true)
  agentPurchasable      Boolean                @default(true)
  attributes            String                 // JSON string of attributes
  returnPolicy          String                 @default("7-day return policy for unopened items")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  merchant              Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  growthRecommendations GrowthRecommendation[]
  inventory             Inventory?
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  available Int      @default(0)
  reserved  Int      @default(0)
  sold      Int      @default(0)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Mandate {
  id                   String           @id @default(cuid())
  userId               String
  agentId              String           @default("buyer_agent")
  merchantId           String?
  intent               String           @default("purchase")
  maxAmount            Float
  currency             String           @default("INR")
  allowedCategories    String           // JSON string array e.g. ["keyboard", "electronics"]
  allowedActions       String           // JSON string array e.g. ["search", "compare", "purchase"]
  confirmationRequired Boolean          @default(false)
  status               String           @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, REVOKED, CONSUMED, BLOCKED
  expiresAt            DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               Order[]
  policyDecisions      PolicyDecision[]
  riskChecks           RiskCheck[]
}

model Order {
  id                String            @id @default(cuid())
  userId            String
  merchantId        String
  mandateId         String?
  amount            Float
  currency          String            @default("INR")
  status            String            @default("PENDING") // PENDING, AUTHORIZED, PAYMENT_PENDING, PAID, PAYMENT_FAILED, CANCELLED, BLOCKED, REFUNDED
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  idempotencyKey    String?           @unique
  failureReason     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  mandate           Mandate?          @relation(fields: [mandateId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  policyDecisions   PolicyDecision[]
  riskChecks        RiskCheck[]
  transactionProof  TransactionProof?
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int      @default(1)
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  amount            Float
  currency          String   @default("INR")
  status            String   @default("PENDING") // PENDING, SUCCESS, FAILED
  razorpayOrderId   String?
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  method            String   @default("UPI_AGENT_DELEGATED")
  signatureValid    Boolean  @default(false)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Policy {
  id                   String   @id @default(cuid())
  merchantId           String
  name                 String
  maxTransactionAmount Float
  allowedCurrency      String   @default("INR")
  mandateRequirement   Boolean  @default(true)
  priceDriftRule       Boolean  @default(true)
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  merchant             Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model PolicyDecision {
  id             String   @id @default(cuid())
  mandateId      String?
  orderId        String?
  decision       String   // ALLOW, BLOCK, REQUIRE_CONFIRMATION
  reasonCodes    String   // JSON string array of reason codes
  rulesEvaluated String   // JSON string details of each rule
  createdAt      DateTime @default(now())
  mandate        Mandate? @relation(fields: [mandateId], references: [id])
  order          Order?   @relation(fields: [orderId], references: [id])
}

model RiskCheck {
  id        String   @id @default(cuid())
  mandateId String?
  orderId   String?
  score     Int      // 0 to 100
  level     String   // LOW, MEDIUM, HIGH
  signals   String   // JSON string array of evaluated risk signals
  createdAt DateTime @default(now())
  mandate   Mandate? @relation(fields: [mandateId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
}

model AuditEvent {
  id           String   @id @default(cuid())
  eventType    String
  actorType    String
  actorId      String
  resourceType String
  resourceId   String
  decision     String?
  reasonCodes  String?
  metadata     String?
  previousHash String?
  hash         String
  createdAt    DateTime @default(now())
}

model TransactionProof {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  decisionHash       String
  transactionHash    String
  proofPayload       String    // JSON string containing canonicalized state, summaries
  verificationStatus String    @default("VALID") // VALID, INVALID, TAMPERED
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  payload   String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Agent {
  id        String      @id @default(cuid())
  type      String      // BUYER, GROWTH, MERCHANT_OPS
  name      String
  status    String      @default("ACTIVE")
  metadata  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tools     AgentTool[]
}

model AgentTool {
  id        String   @id @default(cuid())
  agentId   String
  toolName  String
  endpoint  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
}

model GrowthRecommendation {
  id             String   @id @default(cuid())
  merchantId     String
  productId      String?
  type           String   // UPSELL, CROSS_SELL, BUNDLE, CAMPAIGN
  recommendation String
  reason         String
  confidence     Float    @default(0.85) // 0.0 to 1.0
  expectedImpact String   // JSON string with AOV lift, attach rate, revenue impact
  status         String   @default("PROPOSED") // PROPOSED, REVIEWED, APPROVED, REJECTED, EXECUTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
}

model Campaign {
  id              String   @id @default(cuid())
  merchantId      String
  title           String
  description     String
  discountPercent Float    @default(10.0)
  targetCategory  String
  status          String   @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model AgentInteraction {
  id            String   @id @default(cuid())
  agentId       String   // buyer_agent, growth_agent
  userId        String?
  tool          String   // search_catalog, compare_products, request_checkout, etc.
  action        String
  input         String?  // JSON string
  outputSummary String?  // JSON string or summary text
  success       Boolean  @default(true)
  failureReason String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])
}
