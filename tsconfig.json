{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@race/types": ["./packages/types/src/index.ts"],
      "@race/policy-engine": ["./packages/policy-engine/src/index.ts"],
      "@race/proof-engine": ["./packages/proof-engine/src/index.ts"],
      "@race/agent-core": ["./packages/agent-core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
