# ==============================================================================
# RACE: Razorpay Agentic Commerce Exchange — Environment Configuration
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=development
PORT=4000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# Canonical Production: PostgreSQL
# DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
# Isolated Offline Development Fallback: SQLite (used by prisma/schema.sqlite.prisma)
DATABASE_URL="file:./dev.db"

# Payment Provider Configuration (razorpay | mock)
PAYMENT_PROVIDER=razorpay

# Razorpay Test Mode Credentials (Required when PAYMENT_PROVIDER=razorpay)
# Backend Only — NEVER expose Secret Keys to Frontend
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# AI Provider Configuration (openai | deterministic)
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-YourOpenAIKeyHere"
OPENAI_MODEL="gpt-4o-mini"

# Demo & Security Environment Flags
ENABLE_DEMO_ENDPOINTS=true
