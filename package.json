{
  "name": "race-agentic-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Razorpay Agentic Commerce Exchange - Bounded Autonomy Control Plane",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/**/*.test.mjs tests/**/*.test.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "start:api": "npm run dev --workspace=apps/api",
    "start:web": "npm run dev --workspace=apps/web"
  },
  "keywords": [
    "razorpay",
    "agentic-commerce",
    "fintech",
    "policy-engine",
    "risk-engine",
    "proof-chains"
  ],
  "author": "RACE Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7"
  }
}
